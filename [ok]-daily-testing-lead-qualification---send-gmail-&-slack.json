    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"Subject\": {\n      \"type\": \"string\",\n      \"description\": \"The email subject line, starting with 'uraisolution: ' followed by a brief, personalized description.\"\n    },\n    \"Body\": {\n      \"type\": \"string\",\n      \"description\": \"The personalized email body from uraisolution Team, addressing the lead by their first name, thanking them for their specific interest, and including a call to action. Do not use placeholders. CRITICAL: You must use double newline characters (\\\\n\\\\n) to separate the greeting, the paragraphs, and the sign-off so it renders with clear line breaks.\"\n    },\n    \"Tag\": {\n      \"type\": \"string\",\n      \"enum\": [\"High-Value Lead\", \"Medium-Value Lead\", \"Low-Value Lead\"],\n      \"description\": \"The lead classification based on budget, service interest, and urgency.\"\n    }\n  },\n  \"required\": [\"Subject\", \"Body\", \"Tag\"]\n}"
