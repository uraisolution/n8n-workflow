      "id": "05fd7db4-b81f-4ab7-9325-4b2b9aa4f6f7",
      "name": "Filter Overdue Invoices",
      "type": "n8n-nodes-base.if",
      "position": [
        432,
        208
      ],
      "notesInFlow": true,
      "typeVersion": 2,
      "retryOnFail": false,
      "notes": "Separate overdue from upcoming"
    },
    {
      "parameters": {
        "jsCode": "const invoices = $input.all();\nconst today = new Date();\nconst results = [];\n\nfor (const invoice of invoices) {\n  const data = invoice.json;\n\n  // 1. Hent datafelter direkte fra dit input-schema\n  const rawDueDate = data['Due'];\n  const rawIssueDate = data['Date'];\n  const rawLastReminder = data['Last reminder sent'];\n  \n  // Brug den præcise værdi fra regnearket som fallback, hvis den findes\n  let daysOverdue = parseInt(data['Days overdue'], 10);\n\n  const dueDate = rawDueDate ? new Date(rawDueDate) : null;\n  \n  // Hvis regnearket ikke har værdien, beregner vi den her\n  if (isNaN(daysOverdue) && dueDate && !isNaN(dueDate.getTime())) {\n    daysOverdue = Math.floor((today - dueDate) / (1000 * 60 * 60 * 24));\n  }\n\n  // 2. Gardering: Hvis der hverken er en forfaldsdato eller dage over tid, springes rækken over\n  if (isNaN(daysOverdue) && (!dueDate || isNaN(dueDate.getTime()))) {\n    continue; \n  }\n\n  // 3. Beregn dage siden sidste påmindelse\n  const lastReminder = (rawLastReminder && String(rawLastReminder).trim() !== '') \n    ? new Date(rawLastReminder) \n    : null;\n\n  let daysSinceReminder = 999;\n  if (lastReminder && !isNaN(lastReminder.getTime())) {\n    daysSinceReminder = Math.floor((today - lastReminder) / (1000 * 60 * 60 * 24));\n  }\n\n  // 4. Bestem påmindelsestype ud fra intervaller (rettet til at bruge >= så ingen dage tabes)\n  let reminderType = '';\n  let urgencyLevel = '';\n  let shouldSendReminder = false;\n\n  if (daysOverdue >= 30 && daysSinceReminder >= 3) {\n    reminderType = 'final_notice';\n    urgencyLevel = 'critical';\n    shouldSendReminder = true;\n  } else if (daysOverdue >= 14 && daysSinceReminder >= 5) {\n    reminderType = 'second_reminder';\n    urgencyLevel = 'high';\n    shouldSendReminder = true;\n  } else if (daysOverdue > 0 && daysSinceReminder >= 7) {\n    reminderType = 'first_reminder';\n    urgencyLevel = 'medium';\n    shouldSendReminder = true;\n  } else if (daysOverdue === 0) {\n    reminderType = 'due_today';\n    urgencyLevel = 'medium';\n    shouldSendReminder = true;\n  } else if (daysOverdue < 0 && daysOverdue >= -3 && !lastReminder) {\n    reminderType = 'upcoming_reminder';\n    urgencyLevel = 'low';\n    shouldSendReminder = true;\n  }\n\n  // 5. Output resultatet hvis betingelserne er mødt\n  if (shouldSendReminder) {\n    results.push({\n      json: {\n        ...data,\n        daysOverdue,\n        daysSinceReminder,\n        reminderType,\n        urgencyLevel,\n        shouldSendReminder\n      }\n    });\n  }\n}\n\nreturn results;"
      },
      "id": "e058aff6-07bb-44cd-b364-b76e8097cddc",
      "name": "Calculate Reminder Logic",
      "type": "n8n-nodes-base.code",
      "position": [
        656,
        208
      ],
      "notesInFlow": true,
      "typeVersion": 2,
      "notes": "Smart logic for reminder timing"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ai-prompt",
              "name": "aiPrompt",
              "type": "string",
              "value": "=Generate a professional and friendly payment reminder email for the following invoice:\n\nClient Name: {{ $json.Vendor }}\nInvoice Number: {{ $json['Invoice #'] }}\nAmount: {{ $json.Total }}\nIssue Date: {{ $json.Date }}\nDue Date: {{ $json.Due }}\nDays Overdue: {{ $json.daysOverdue }}\nDescription: {{ $json.Description }}\n\nThe email should:\n- Be courteous and professional\n- Clearly state the outstanding amount and invoice details\n- Mention the due date and overdue status if applicable\n- Include a polite call-to-action for payment\n- Provide payment instructions or link\n- Be appropriately urgent based on the reminder type\n- End with a professional signature by including URAI Solution (our company)\n\nFormat the response as a complete email with subject line. Do not put the subject line in the e-mail response only in the subject line of the e-mail. Include the Invoice ID {{ $json['Invoice #'] }}"
            }
          ]
        },
        "options": {}
      },
      "id": "1e64c1da-39fd-4ce7-a293-d759397d474b",
      "name": "Prepare AI Prompt",
      "type": "n8n-nodes-base.set",
      "position": [
        880,
        208
      ],
      "typeVersion": 3.4,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n  \n  // 1. Safe AI input capture\n  let aiResponse = data.output || '';\n  if (typeof aiResponse !== 'string') {\n    aiResponse = String(aiResponse);\n  }\n\n  // Convert literal \"\\n\" text strings to real line breaks\n  aiResponse = aiResponse.replace(/\\\\n/g, '\\n');\n\n  // 2. Extract and strip out Subject\n  const subjectMatch = aiResponse.match(/Subject:\\s*(.+?)(?:\\n|$)/i);\n  \n  // --- UPDATED FALLBACK TO USE INVOCIE ID ---\n  const invoiceId = data['Invocie ID'] || data['Invoice number'] || 'N/A';\n  const subject = subjectMatch ? subjectMatch[1].trim() : `Payment Reminder - Invoice ID ${invoiceId}`;\n  \n  let mainBody = aiResponse.replace(/Subject:\\s*.+?(?:\\n|$)/i, '').trim();\n  if (!mainBody) { mainBody = aiResponse; }\n\n  // 3. Clean up greeting formatting dynamically based on your Sheet input\n  const clientName = data['Client name'] || 'Customer';\n  const greetingRegex = new RegExp(`Dear\\\\s+${clientName},?`, 'i');\n  mainBody = mainBody.replace(greetingRegex, `Dear ${clientName},`);\n\n  // 4. Extract target data table variables safely\n  const invoiceNum = data['Invoice number'] || 'N/A';\n  const currency = data['Currency'] || '';\n  const amount = data['Invoice amount'] || '0.00';\n  const dueDate = data['Due date'] || 'N/A';\n  const daysOverdue = parseInt(data['Days overdue'] || data.daysOverdue, 10);\n\n  let statusText = 'Due Soon';\n  let statusColor = '#f57c00';\n  if (!isNaN(daysOverdue) && daysOverdue > 0) {\n    statusText = `Overdue by ${daysOverdue} days`;\n    statusColor = '#d32f2f';\n  }\n\n  // Build the clean HTML Table block\n  const invoiceTable = `\n  <div style=\"background-color: #f5f5f5; padding: 20px; border-radius: 8px; margin: 20px 0; max-width: 500px;\">\n    <h3 style=\"color: #333; margin-top: 0; font-family: Arial, sans-serif;\">Invoice Details</h3>\n    <table style=\"width: 100%; border-collapse: collapse; font-family: Arial, sans-serif; font-size: 14px;\">\n      <tr>\n        <td style=\"padding: 8px 0; font-weight: bold; color: #555;\">Invoice Number:</td>\n        <td style=\"padding: 8px 0; text-align: right; color: #333;\">${invoiceNum}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 8px 0; font-weight: bold; color: #555;\">Invoice ID:</td>\n        <td style=\"padding: 8px 0; text-align: right; color: #333;\">${invoiceId}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 8px 0; font-weight: bold; color: #555;\">Amount:</td>\n        <td style=\"padding: 8px 0; text-align: right; color: #333; font-weight: bold;\">${currency} ${amount}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 8px 0; font-weight: bold; color: #555;\">Due Date:</td>\n        <td style=\"padding: 8px 0; text-align: right; color: #333;\">${dueDate}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 8px 0; font-weight: bold; color: #555;\">Status:</td>\n        <td style=\"padding: 8px 0; text-align: right; color: ${statusColor}; font-weight: bold;\">${statusText}</td>\n      </tr>\n    </table>\n  </div>\n  `;\n\n  // 5. REMOVE THE EXAMPLE LINES AND PLACEHOLDERS COMPLETELY\n  mainBody = mainBody\n    .replace(/\\[Insert your preferred payment instructions[\\s\\S]*?\\]/gi, '') // Strips bracket text\n    .replace(/^.*\\*Example:.*$/gm, '')                                       // Strips any line containing *Example:*\n    .replace(/\\n\\s*\\n\\s*\\n/g, '\\n\\n')                                        // Cleans up trailing blank space lines\n    .trim();\n\n  // 6. Split body up around the table insertion spot dynamically\n  let introduction = `Dear ${clientName},`;\n  let contentText = mainBody;\n\n  if (mainBody.toLowerCase().startsWith(`dear ${clientName.toLowerCase()},`)) {\n    contentText = mainBody.substring(`dear ${clientName},`.length).trim();\n  }\n\n  // Convert text paragraphs to HTML breaks safely\n  let formattedContent = contentText\n    .replace(/\\*\\*(.+?)\\*\\*/g, '<strong>$1</strong>')\n    .replace(/\\n/g, '<br>');\n\n  // Isolate sections dynamically to drop table in perfectly after instructions intro paragraph\n  const splitPoints = formattedContent.split('<br><br>');\n  const topSection = splitPoints.slice(0, 3).join('<br><br>');\n  const bottomSection = splitPoints.slice(3).join('<br><br>');\n\n  // 7. Assemble Final Email Layout\n  const htmlBody = `\n  <html>\n    <body style=\"font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px;\">\n      <p style=\"margin-bottom: 20px;\">${introduction}</p>\n      <div>${topSection}</div>\n      ${invoiceTable}\n      <div>${bottomSection}</div>\n      <div style=\"margin-top: 30px; padding-top: 20px; border-top: 1px solid #ddd; font-size: 12px; color: #666;\">\n        <p>This is an automated reminder. If you have already made this payment, please disregard this email.</p>\n      </div>\n    </body>\n  </html>\n  `;\n  \n  results.push({\n    json: {\n      ...data,\n      emailSubject: subject,\n      emailBody: htmlBody,\n      emailBodyPlain: mainBody.replace(/<[^>]*>/g, '')\n    }\n  });\n}\n\nreturn results;"
      },
